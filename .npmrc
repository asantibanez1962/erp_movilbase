# Expo + React Native NO entienden la estructura nested de pnpm.
# Metro busca módulos en un node_modules flat (estilo npm/yarn).
# `node-linker=hoisted` hace que pnpm cree esa estructura flat aún en
# monorepo, manteniendo el resto de los beneficios de pnpm (workspaces,
# velocidad, lockfile).
#
# Recomendación oficial de Expo:
# https://docs.expo.dev/guides/monorepos/#use-npmrc
node-linker=hoisted

# Auto-install de peer deps — sin esto cada warning de peer requiere
# que el dev lo agregue manualmente al package.json.
auto-install-peers=true
