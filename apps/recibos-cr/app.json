{
  "expo": {
    "name": "Recibos CR",
    "slug": "recibos-cr",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "cr.confeldan.recibos",
      "versionCode": 1,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "extra": {
      "apiBaseUrl": "http://10.0.2.2:5249",
      "eas": {
        "projectId": "51dc23bb-a5b3-4902-a268-2ad5c533b6cf"
      }
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "owner": "alfredosantibanez"
  }
}
