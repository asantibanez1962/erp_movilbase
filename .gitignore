# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
*.tsbuildinfo

# Expo / RN
.expo/
.expo-shared/
expo-env.d.ts
web-build/

# Android native — la carpeta entera es generada por `expo prebuild`.
# Con expo-build-properties + plugins en app.json, EAS Build re-genera
# en cada build. Nunca commitear. Si necesitás builds locales (WSL2/Mac),
# corré `npx expo prebuild --platform android` en tu dev box.
**/android/

# iOS native — idem android. EAS Build hace prebuild en cada build cloud.
**/ios/

# Keystores en caso queden sueltos en android/ (defense in depth — la
# carpeta android/ ya está ignorada arriba pero por si alguien la commitea).
**/*.keystore
**/*.jks
**/keystore.properties

# Keystores (DO NOT COMMIT — backup separately!)
*.keystore
*.jks
keystore.properties

# EAS / Expo secrets
.env
.env.local
.env.*.local
eas-secret.json

